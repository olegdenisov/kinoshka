{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // src/main.tsx — единственная точка входа приложения (Vite bootstrap).
  // *.test.{ts,tsx} — без этого knip считает тестовые файлы и большинство
  // devDependencies (vitest, msw, testing-library, ...) неиспользуемыми.
  // Root-конфиги (vite.config.ts/sentry.config.ts/apicraft.config.ts) — иначе
  // apicraft/husky/commitlint и т.п. тоже попадают в unused deps. bundle.config.ts
  // добавлен по той же причине (введён в Task 4 этого плана, после того как этот
  // раздел плана был написан). playwright.config.ts + e2e/**/*.spec.ts — иначе
  // @playwright/test/@axe-core/playwright считаются unused devDependencies (knip
  // умеет автоопределять Playwright по playwright.config.ts, но явная запись — в
  // духе уже принятого в проекте стиля "explicit decision", см. AGENTS.md 2.5.3).
  "entry": [
    "src/main.tsx",
    "**/*.test.{ts,tsx}",
    "vite.config.ts",
    "sentry.config.ts",
    "apicraft.config.ts",
    "bundle.config.ts",
    "playwright.config.ts",
    "e2e/**/*.spec.ts",
    // Task 3, docs/plans/20260915-telemetry-dashboard-sentry-alerts.md — provisioning-скрипт
    // поверх `sentry` CLI + его чистый конфиг-модуль. Тестовые файлы уже покрыты глобом
    // "**/*.test.{ts,tsx}" выше.
    "sentry-telemetry.config.ts",
    "provision-sentry-telemetry.ts",
  ],
  // e2e/**/*.ts (helper-модули типа e2e/utils/a11y.ts, не сами *.spec.ts,
  // те уже entry выше) — без этого knip не резолвит импорты внутри e2e/utils/
  // как часть графа зависимостей и продолжает считать @axe-core/playwright
  // unused, даже когда a11y.ts его реально импортирует.
  "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"],
  "ignore": [
    // Сгенерированные файлы — AGENTS.md прямо запрещает их редактировать
    // ("Generated files — never edit manually, regenerate instead").
    "src/shared/api/*.gen.ts",
    // AGENTS.md, "Feature flag not wired": весь модуль useFeatureFlag()/FeatureGate/
    // FeatureName документирован как намеренно без текущего потребителя — тот же
    // прецедент, что popularThisWeek/toggleTheme, оставленные false без подключения.
    "src/shared/config/**",
    // Публичные барели слайсов (AGENTS.md, "Key public APIs") — реэкспортируют
    // getFilterFromSearchParams/CatalogQueryParams, UseFavoritesResult, useTheme/
    // UseThemeResult/Theme, ErrorBoundary как часть намеренного публичного API,
    // даже если у конкретного экспорта пока нет внешнего потребителя за пределами
    // самого слайса (та же причина, что у add(id) в useFavorites).
    "src/features/catalog-filter/index.ts",
    "src/features/favorites/index.ts",
    "src/features/theme/index.ts",
    "src/shared/ui/index.ts",
  ],
  // `sentry` — глобально установленный CLI-инструмент (см. docs/plans/20260915-telemetry-dashboard-sentry-alerts.md,
  // "sentry CLI — установлен и авторизован на этой машине"), не npm-зависимость репозитория — knip
  // иначе флагует его как "Unlisted binary" в provision-sentry-telemetry.ts (execFileSync('sentry', ...)).
  "ignoreBinaries": ["sentry"],
}
