{
  "name": "kinoshka",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint . && pnpm lint:css",
    "lint:css": "stylelint 'src/**/*.module.css'",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "preview": "vite preview",
    "generate-api": "npx apicraft generate --config apicraft.config.ts",
    "test": "vitest",
    "prepare": "husky",
    "commit": "cz"
  },
  "dependencies": {
    "@sentry/react": "^10.71.0",
    "@siberiacancode/fetches": "^1.14.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^8.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@sentry/vite-plugin": "^5.4.0",
    "@siberiacancode/apicraft": "^1.12.1",
    "@size-limit/file": "^13.0.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/babel__core": "^7.20.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "lint-staged": "^17.4.1",
    "msw": "^2.15.0",
    "oxfmt": "^0.65.0",
    "oxlint": "1.80.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "size-limit": "^13.0.3",
    "stylelint": "^17.15.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt --write",
      "oxlint --fix --deny-warnings"
    ],
    "*.module.css": [
      "stylelint"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "size-limit": [
    {
      "name": "entry",
      "path": "dist/assets/index-*.js",
      "gzip": true,
      "limit": "3.4 KB"
    },
    {
      "name": "vendor",
      "path": "dist/assets/vendor-*.js",
      "gzip": true,
      "limit": "184.7 KB"
    },
    {
      "name": "shared",
      "path": "dist/assets/shared-*.js",
      "gzip": true,
      "limit": "22.6 KB"
    },
    {
      "name": "page-home",
      "path": "dist/assets/page-home-*.js",
      "gzip": true,
      "limit": "3 KB"
    },
    {
      "name": "page-movie",
      "path": "dist/assets/page-movie-*.js",
      "gzip": true,
      "limit": "8.75 KB"
    },
    {
      "name": "page-favorites",
      "path": "dist/assets/page-favorites-*.js",
      "gzip": true,
      "limit": "1.3 KB"
    },
    {
      "name": "page-popular",
      "path": "dist/assets/page-popular-*.js",
      "gzip": true,
      "limit": "1.25 KB"
    },
    {
      "name": "page-recommendations",
      "path": "dist/assets/page-recommendations-*.js",
      "gzip": true,
      "limit": "1.35 KB"
    },
    {
      "name": "page-search",
      "path": "dist/assets/page-search-*.js",
      "gzip": true,
      "limit": "7 KB"
    },
    {
      "name": "page-profile",
      "path": "dist/assets/page-profile-*.js",
      "gzip": true,
      "limit": "3.1 KB"
    }
  ]
}
