{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "sentry.config.ts",
    "sentry.config.test.ts",
    "bundle.config.ts",
    "bundle.config.test.ts",
    "vercel-headers.test.ts",
    "lighthouse-config.test.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "sentry-telemetry.config.ts",
    "sentry-telemetry.config.test.ts",
    "provision-sentry-telemetry.ts",
    "provision-sentry-telemetry.test.ts",
    "mcp-config.test.ts"
  ]
}
